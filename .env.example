SAP_OAUTH_URL=https://example.sap.com/oauth/token
SAP_CLIENT_ID=your_client_id
SAP_CLIENT_SECRET=your_client_secret
SAP_API_BASE_URL=https://example.sap.com/api

# Google Gemini API Key for LLM Service
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# Or OLLAMA_URL=http://localhost:11434

# Telegram Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
