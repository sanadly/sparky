# SAP Configuration
# Get these from INTENSE AG
SAP_CLIENT_ID=your_client_id
SAP_CLIENT_SECRET=your_client_secret
SAP_OFFER_GROUP=Simulation Gruppe1

# SAP URLs (Development)
AUTH_URL=https://intense-ag-development.authentication.eu10.hana.ondemand.com/oauth/token
PRODUCT_URL=https://intense-ag-development.it-cpi018-rt.cfapps.eu10-003.hana.ondemand.com/http/v1/s4/upil/product/information
SIMULATION_URL=https://intense-ag-development.it-cpi018-rt.cfapps.eu10-003.hana.ondemand.com/http/v1/s4/upil/product/simulation
OFFER_URL=https://intense-ag-development.it-cpi018-rt.cfapps.eu10-003.hana.ondemand.com/http/v1/servicecloud/create/offer

# Google Gemini API (Required for AI features)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-flash-latest

# Telegram Bot
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Feature Flags (Optional)
# Set to True to force mock mode even if credentials are present
MOCK_SAP=False
MOCK_LLM=False
LOG_LEVEL=INFO
